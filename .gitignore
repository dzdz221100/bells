# Secrets — never commit a real key. .env.example is the template and is kept.
.env
.env.*
!.env.example

# Environments and caches
.venv/
__pycache__/
*.pyc
node_modules/

# Build output
dist/
.vite/

# SQLite side files. data/bells.db itself IS committed: it is the seeded demo
# wedding, and without it a fresh clone has nothing to show.
*.db-journal
*.db-wal
*.db-shm

.DS_Store
