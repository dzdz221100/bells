# Copy to .env — either in this folder (repo root) or one folder ABOVE it.
# Bells loads both; the repo-root one wins on conflict. Never commit a real key.
PORTKEY_API_KEY=
OPENAI_API_KEY=

# Host console passcode. Leave unset to use the demo default shown on screen.
BELLS_HOST_PASSCODE=

# gpt-6-luna list prices, USD per million tokens. These are published rates,
# not secrets, so they ship with values — the host console's Spend panel reads
# them. Unset any of the two required ones and cost reads "not priced" rather
# than guessing.
BELLS_PRICE_INPUT_PER_MTOK=0.10
BELLS_PRICE_CACHED_INPUT_PER_MTOK=0.01
BELLS_PRICE_CACHE_WRITE_PER_MTOK=0.125
BELLS_PRICE_OUTPUT_PER_MTOK=0.50
